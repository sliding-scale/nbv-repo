# Copy to .env.local and fill in. Restart `npx expo start` after changing it.

# Convex deployment URL (the same deployment the admin dashboard uses).
# On a physical phone, 127.0.0.1 is the phone itself: use a cloud deployment URL
# (https://<name>.convex.cloud) or your computer's LAN IP for a local backend.
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Google Maps API key for the live van map (same Google Cloud project as the admin dashboard).
# Enable "Maps SDK for Android", "Maps SDK for iOS" and "Maps JavaScript API" (web) for it.
# Android/iOS: the key is built into the app, so rebuild the development build after changing it.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Web only: Map ID for advanced markers. DEMO_MAP_ID is used when unset.
# EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID=
