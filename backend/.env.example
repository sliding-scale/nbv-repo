# Convex DEPLOYMENT environment variables. These are not read from this file: set each one on
# the deployment with `npx convex env set NAME value` (or Convex dashboard → Settings → Environment Variables).

# ----- Admin dashboard (Clerk) -----
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# ----- Parent app sign-in (Convex Auth, email code) -----
# RS256 key pair Convex Auth signs parent tokens with: JWT_PRIVATE_KEY is the PKCS#8 private key
# (PEM, line breaks replaced by spaces), JWKS is {"keys":[{"use":"sig", ...public key as a JWK}]}.
JWT_PRIVATE_KEY=
JWKS=
# Required by Convex Auth. The parent app doesn't use redirects, so any URL with a host works.
# It must have something after "//": a bare "parentapp://" crashes sign-in with "Invalid URL: 'http:/'".
SITE_URL=parentapp://app

# Resend API key (resend.com → API Keys).
AUTH_RESEND_KEY=re_xxxxxxxxxxxx
# Sender for sign-in emails. Must be on a domain verified in Resend.
# Leave unset to use Resend's test sender, which only delivers to your own Resend account email.
AUTH_EMAIL_FROM=VanTrack <login@your-domain.com>
# DEV ONLY: "true" skips Resend and prints sign-in codes to the Convex logs. Never set this in production.
AUTH_OTP_LOG_ONLY=true
